{
  "cleanUrls": false,
  "functions": {
    "api/call.py": {
      "includeFiles": "api/_lib/**",
      "maxDuration": 10
    },
    "api/voice.py": {
      "includeFiles": "{api/_lib/**,api/call.py}",
      "maxDuration": 30
    },
    "api/live.py": {
      "includeFiles": "api/_lib/**",
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/assets/audio/(.*)\\.m4a",
      "headers": [
        {
          "key": "Content-Type",
          "value": "audio/mp4"
        }
      ]
    },
    {
      "source": "/verify/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
