{"args_digest":"3b07f6d169c369d31286fdb91ee4e80929a099412e4210362824b33d6252141b","hash":"878441b468a39e739d7d070c0dc3dd148776d61ed120fd47912c19c2b3ef822e","payload":{"agent":"fix","approver":null,"args":{"path":"payments_api/refunds.py","ref":"fix/duplicate-refunds-3d01"},"args_digest":"3b07f6d169c369d31286fdb91ee4e80929a099412e4210362824b33d6252141b","delegation_chain":["user:platform-engineer","orchestrator","fix"],"denial_step":"","executed":true,"intent_mismatch":"","kind":"call","meta":{"mirror_rule":"fix-works-on-a-branch","real_world_reason":"Change management: the fix is prepared on a branch and proposed as a pull request"},"mode":"gated","outside_task":false,"policy_name":"fix-works-on-a-branch","policy_version":"payments-incident@v1","real_world_reason":"Change management: the fix is prepared on a branch and proposed as a pull request","reason":"Change management: the fix is prepared on a branch and proposed as a pull request","result_preview":"from __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom decimal import ROUND_HALF_UP, Decimal\n\n\ndef to_minor_units(amount: float) -> …","rule":"fix-works-on-a-branch","run_id":"20261010-121100-2a84","source":"local-policy-stand-in (not AgntID)","task_id":"0e781486-9ca6-4e2b-892f-b3b00813d094","timestamp":1791614460.7455208,"tool":"github.get_file_contents","verb":"ALLOW"},"prev_hash":"bcf26891136fbaebf00d66db44c184cbc6db7132bcbee4ce5a3b1b1602fa6183","seq":19,"sig":"XPf9wB60i5n1I1Lj2TTEyl5pHUlJB2Tkgy8ELUlHKG4fw9M+Cv7wgDc8a67s54iLsXo0YyIeqd+AFb7e55fpBA=="}
{"args_digest":"c64eb733997524f59b2728aa2a43fec97e288917d38a49d14c6a715700c71b79","hash":"290d043e1f531a9cce0885bc471a95e1484d9f125d7fffb941315f115bdbabd8","payload":{"agent":"fix","approver":null,"args":{"branch":"fix/duplicate-refunds-3d01","content":"from __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom decimal import ROUND_HALF_UP, Decimal\n\n\ndef to_minor_units(amount: float) -> int:\n    return int((Decimal(str(amount)) * 100).quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP))\n\n\n@dataclass\nclass RefundLedger:\n    \"\"\"Refunds issued against charges. A client retry resends the same idempotency key.\"\"\"\n\n    charges: dict[str, int] = field(default_factory=dict)\n    refunds: list[dict] = field(default_factory=list)\n    by_key: dict[str, dict] = field(default_factory=dict)\n\n    def refunded(self, order_id: str) -> int:\n        return sum(r[\"amount_minor\"] for r in self.refunds if r[\"order_id\"] == order_id)\n\n    def issue(self, order_id: str, requested: float, idempotency_key: str) -> dict:\n        amount = to_minor_units(requested)\n        seen = self.by_key.get(idempotency_key)\n        if seen is not None:\n            if seen[\"order_id\"] != order_id or seen[\"amount_minor\"] != amount:\n                raise ValueError(\"idempotency key reused with different parameters\")\n            return seen\n        if amount <= 0:\n            raise ValueError(\"refund must be positive\")\n        if self.refunded(order_id) + amount > self.charges[order_id]:\n            raise ValueError(\"refund exceeds charge\")\n        refund = {\"id\": len(self.refunds) + 1, \"order_id\": order_id, \"amount_minor\": amount,\n                  \"idempotency_key\": idempotency_key}\n        self.refunds.append(refund)\n        self.by_key[idempotency_key] = refund\n        return refund\n","message":"fix: honour the refund idempotency key (#1)","path":"payments_api/refunds.py"},"args_digest":"c64eb733997524f59b2728aa2a43fec97e288917d38a49d14c6a715700c71b79","delegation_chain":["user:platform-engineer","orchestrator","fix"],"denial_step":"","executed":true,"intent_mismatch":"","kind":"call","meta":{"mirror_rule":"fix-works-on-a-branch","real_world_reason":"Change management: the fix is prepared on a branch and proposed as a pull request"},"mode":"gated","outside_task":false,"policy_name":"fix-works-on-a-branch","policy_version":"payments-incident@v1","real_world_reason":"Change management: the fix is prepared on a branch and proposed as a pull request","reason":"Change management: the fix is prepared on a branch and proposed as a pull request","result_preview":"committed payments_api/refunds.py to fix/duplicate-refunds-3d01: 4e5aa50","rule":"fix-works-on-a-branch","run_id":"20261010-121100-2a84","source":"local-policy-stand-in (not AgntID)","task_id":"0e781486-9ca6-4e2b-892f-b3b00813d094","timestamp":1791614460.817151,"tool":"github.create_or_update_file","verb":"ALLOW"},"prev_hash":"878441b468a39e739d7d070c0dc3dd148776d61ed120fd47912c19c2b3ef822e","seq":20,"sig":"zelKA2Qa8Y+ZIzgJZN5qFxuJVm1VoqXTBcxQTaTpA3hmuuoHkWozOVJpX5sZksL2dr66Q5O4+4QzoSuDm+dvBA=="}
