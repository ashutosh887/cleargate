{"args_digest":"86a0bbe7aaa3ab0f06a1f7a792d16b1862559fe91cfdcc4078150de5c96e6135","hash":"e9fb435ba0e8a56b3452f20e8a7273086cd611b3344a3fef2806fa18bccdb8a8","payload":{"agent":"fix","approver":null,"args":{"path":"payments_api/refunds.py","ref":"fix/duplicate-refunds-f40f"},"args_digest":"86a0bbe7aaa3ab0f06a1f7a792d16b1862559fe91cfdcc4078150de5c96e6135","delegation_chain":["user:platform-engineer","orchestrator","fix"],"denial_step":"","executed":true,"intent_mismatch":"","kind":"call","meta":{"policy_classifies_as":"ALLOW"},"mode":"stock","outside_task":false,"policy_name":"","policy_version":"payments-incident@v1","real_world_reason":"","reason":"","result_preview":"from __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom decimal import ROUND_HALF_UP, Decimal\n\n\ndef to_minor_units(amount: float) -> …","rule":"","run_id":"20261010-121100-2a84","source":"stock (no enforcement)","task_id":"41412acb-292b-41bc-8b20-40712e78ad9a","timestamp":1791614460.813968,"tool":"github.get_file_contents","verb":"UNGUARDED"},"prev_hash":"84486a2d32890db0f06f09ea457771bb40bc48e19fae7d6e002085996a5e8c58","seq":19,"sig":"1Q4tVZwcc5DtAfd5cpXvtjI7UYB4wpbZEfTEdTDWUNLgTrKdotzyNpeLeVKaa+6x1ty/7f6aepWl8Xicbj0IBg=="}
{"args_digest":"e319e1c29d1814a8d8dc0897aefaebc99ca0a4b47a4a899141279c277cf1d1d3","hash":"4519ee91cbfada1c971376cfc8e79de8edd7a3e53446f07341d7bd52a9b243be","payload":{"agent":"fix","approver":null,"args":{"branch":"fix/duplicate-refunds-f40f","content":"from __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom decimal import ROUND_HALF_UP, Decimal\n\n\ndef to_minor_units(amount: float) -> int:\n    return int((Decimal(str(amount)) * 100).quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP))\n\n\n@dataclass\nclass RefundLedger:\n    \"\"\"Refunds issued against charges. A client retry resends the same idempotency key.\"\"\"\n\n    charges: dict[str, int] = field(default_factory=dict)\n    refunds: list[dict] = field(default_factory=list)\n    by_key: dict[str, dict] = field(default_factory=dict)\n\n    def refunded(self, order_id: str) -> int:\n        return sum(r[\"amount_minor\"] for r in self.refunds if r[\"order_id\"] == order_id)\n\n    def issue(self, order_id: str, requested: float, idempotency_key: str) -> dict:\n        amount = to_minor_units(requested)\n        seen = self.by_key.get(idempotency_key)\n        if seen is not None:\n            if seen[\"order_id\"] != order_id or seen[\"amount_minor\"] != amount:\n                raise ValueError(\"idempotency key reused with different parameters\")\n            return seen\n        if amount <= 0:\n            raise ValueError(\"refund must be positive\")\n        if self.refunded(order_id) + amount > self.charges[order_id]:\n            raise ValueError(\"refund exceeds charge\")\n        refund = {\"id\": len(self.refunds) + 1, \"order_id\": order_id, \"amount_minor\": amount,\n                  \"idempotency_key\": idempotency_key}\n        self.refunds.append(refund)\n        self.by_key[idempotency_key] = refund\n        return refund\n","message":"fix: honour the refund idempotency key (#1)","path":"payments_api/refunds.py"},"args_digest":"e319e1c29d1814a8d8dc0897aefaebc99ca0a4b47a4a899141279c277cf1d1d3","delegation_chain":["user:platform-engineer","orchestrator","fix"],"denial_step":"","executed":false,"intent_mismatch":"","kind":"call","meta":{"policy_classifies_as":"ALLOW"},"mode":"stock","outside_task":false,"policy_name":"","policy_version":"payments-incident@v1","real_world_reason":"","reason":"","result_preview":"Command '['git', '-c', 'user.name=cleargate-agent', '-c', 'user.email=agent@cleargate.local', 'commit', '-q', '-m', 'fix: honour the refund idempotency key (#1…","rule":"","run_id":"20261010-121100-2a84","source":"stock (no enforcement)","task_id":"41412acb-292b-41bc-8b20-40712e78ad9a","timestamp":1791614460.87934,"tool":"github.create_or_update_file","verb":"UNGUARDED"},"prev_hash":"e9fb435ba0e8a56b3452f20e8a7273086cd611b3344a3fef2806fa18bccdb8a8","seq":20,"sig":"w92LYFuY08zPq4IoCoz74DRmy8WZiasYkbv1gnM8z/Bx8mGef42CTXOZlXW+B4xnjJLViNEP/CvWgEGQYpGYAw=="}
