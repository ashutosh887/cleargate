# tool backends: stub (offline) or live
CLEARGATE_GITHUB=stub
CLEARGATE_POSTGRES=stub
CLEARGATE_SLACK=stub

# enforcement backend for gated mode: local (policy stand-in) or agntid
CLEARGATE_ENFORCER=local

# model: scripted (offline, deterministic) or openai (any OpenAI-compatible endpoint)
CLEARGATE_LLM=scripted
OPENAI_BASE_URL=
OPENAI_API_KEY=
CLEARGATE_MODEL=

# GitHub REST (live)
GITHUB_TOKEN=
GITHUB_REPO=owner/payments-api
CLEARGATE_ISSUE=47

# Postgres (live)
DATABASE_URL=postgresql://localhost:5432/payments

# Slack (live): a bot token for posting and approvals, or a webhook for posting only
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=
SLACK_APPROVAL_CHANNEL=#inc-4471
SLACK_SIGNING_SECRET=
