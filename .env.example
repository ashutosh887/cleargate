# ClearGate configuration. Copy to .env (gitignored) and fill in.
# Every value is optional: with nothing set, `cleargate check` runs fully offline
# (stub tools, local policy stand-in, scripted agents).
# Lines marked [planned] are not read by the code yet.

# --- Mode switches -----------------------------------------------------------
# tool backends: stub (offline) or live
CLEARGATE_GITHUB=stub
CLEARGATE_POSTGRES=stub
CLEARGATE_SLACK=stub

# enforcement for gated mode: local (policy stand-in) or agntid
CLEARGATE_ENFORCER=local

# agent brain: scripted (offline, deterministic), openai (any OpenAI-compatible endpoint),
# bedrock (Converse API, falls back to BEDROCK_FALLBACK_MODEL_ID, then ANTHROPIC_API_KEY), or anthropic
CLEARGATE_LLM=scripted
CLEARGATE_MODEL=

# policy file (default: ./policy.yaml)
CLEARGATE_POLICY=

# --- AgntID runtime ----------------------------------------------------------
# MCP endpoint of the runtime (compose maps 8082 -> 8000); UI/API on :8080
AGNTID_MCP_URL=http://localhost:8082/mcp
# raw OAuth access token, no "Bearer " prefix; leave empty if the runtime allows unauthenticated access
AGNTID_ACCESS_TOKEN=
# how review_required comes back: error or envelope (confirm in the Phase 1 spike)
AGNTID_REVIEW_SHAPE=error
# 0 (default): an approved merge is re-sent through the runtime, which makes the final decision.
# 1: fallback only; ClearGate executes the approved call on its own client and the record says so.
AGNTID_DIRECT_APPROVED_EXECUTE=0

# --- LLM: Amazon Bedrock (AWS credits) ---------------------------------------
# Bedrock API key (same one ARENA uses, from AWS credits); boto3 reads it natively
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5-5
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_FALLBACK_MODEL_ID=global.anthropic.claude-haiku-5-5

# --- LLM: OpenAI-compatible (alternative) ------------------------------------
# --- LLM: Anthropic API direct (fallback if Bedrock throttles) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
CLEARGATE_LLM_MAX_TOKENS=1024
OPENAI_BASE_URL=
OPENAI_API_KEY=

# --- GitHub (live) -----------------------------------------------------------
# fine-grained PAT from ashutosh887, scoped to the demo repo only
# (contents, issues, pull requests: read/write)
GITHUB_TOKEN=
GITHUB_REPO=ashutosh887/cleargate
CLEARGATE_ISSUE=1

# --- Postgres (live) ---------------------------------------------------------
# docker run -d --name cleargate-pg -e POSTGRES_PASSWORD=cleargate -e POSTGRES_DB=payments -p 5432:5432 postgres:16
DATABASE_URL=postgresql://postgres:cleargate@localhost:5432/payments

# --- Slack (live) ------------------------------------------------------------
# bot token (xoxb-) for posting and approvals, or a webhook for posting only
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=
SLACK_APPROVAL_CHANNEL=#inc-4471
# HTTP interactions (needs a public URL, e.g. cloudflared): the signing secret is required
SLACK_SIGNING_SECRET=
# Socket Mode app-level token (xapp-), so approvals work without a tunnel [planned, Phase 3]
SLACK_APP_TOKEN=

# --- Voice: Sarvam AI (on-call escalation call at /oncall) -------------------
# TTS (en-IN) and STT (saaras:v4). Empty: the page falls back to the browser's Web Speech API.
SARVAM_API_KEY=
# optional Sarvam speaker name; empty uses Sarvam's default voice
SARVAM_TTS_SPEAKER=
# public HTTPS base URL for the phone (e.g. from `cloudflared tunnel --url http://localhost:8700`)
CLEARGATE_PUBLIC_URL=

# off = the bank's old payout path without payee registration (stage demo: stock visibly moves money); on = payee check in the payments server
PAYEE_CHECK=off
